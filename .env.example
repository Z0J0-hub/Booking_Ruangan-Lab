# Salin ke .env. Ambil nilai publik dari project Supabase yang sudah digunakan.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Publishable key atau legacy anon key. Jangan gunakan service_role / sb_secret_.
VITE_SUPABASE_ANON_KEY=your_public_anon_or_publishable_key
# VITE_* tertanam di bundle browser. Setelah mengganti nilai, build ulang.
# Tidak diperlukan DB_PASSWORD, JWT_SECRET, atau MySQL untuk aplikasi aktif.
