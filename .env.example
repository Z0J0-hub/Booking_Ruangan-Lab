
# ---- Frontend API ----
VITE_API_URL=http://localhost:3000/api

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lab_booking
DB_USER=lab_booking
DB_PASSWORD=replace_with_database_password
DB_ROOT_PASSWORD=replace_with_mysql_root_password

# ---- JWT Authentication ----
JWT_SECRET=replace_with_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Lab Booking System <noreply@telkom.ac.id>"

# ---- Docker Registry ----
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your_docker_hub_username

# ---- Jenkins Credentials IDs ----
# Configure these in Jenkins > Credentials > System
# docker-hub-credentials: Docker Hub username/password
# sonarqube-token: SonarQube authentication token

# ---- SonarQube ----
SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=your_sonarqube_token

# ---- Redis (Production) ----
REDIS_PASSWORD=your_redis_password

# ---- Monitoring (Optional) ----
SENTRY_DSN=
LOG_LEVEL=info
