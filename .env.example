# =============================================================================
# Lab Booking System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.

# ---- Frontend / Docker build (required by the current application) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public anon key only; never use the Supabase service_role key here.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Rebuild the Docker image after changing these values.

# The settings below belong to the legacy backend/CI templates.
# The current frontend-only Docker Compose files do not use them.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab_booking
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ---- JWT Authentication ----
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRES_IN=900

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- Rate Limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Lab Booking System <noreply@telkom.ac.id>"

# ---- Docker Registry ----
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your_docker_hub_username

# ---- Jenkins Credentials IDs ----
# Configure these in Jenkins > Credentials > System
# docker-hub-credentials: Docker Hub username/password
# sonarqube-token: SonarQube authentication token

# ---- SonarQube ----
SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=your_sonarqube_token

# ---- Redis (Production) ----
REDIS_PASSWORD=your_redis_password

# ---- Monitoring (Optional) ----
SENTRY_DSN=
LOG_LEVEL=info
