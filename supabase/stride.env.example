# Copy privately to .env.stride.local at the project root; it is ignored by Git.
# Use the PostgreSQL direct/session connection string from Supabase Connect.
# This is a DB password credential, not the public key or service_role API key.
STRIDE_DATABASE_URL=
STRIDE_DB_HOST=
# Explicit approval for synthetic test writes on a development database only.
STRIDE_ALLOW_TEST_WRITES=rollback-only
# Optional trusted Supabase root CA file. TLS verification is never disabled.
STRIDE_CA_FILE=
