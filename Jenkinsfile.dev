pipeline {
    agent any

    stages {

        stage('Cek Lingkungan') {
            steps {
                bat '''
                    whoami
                    hostname
                
                    node --version
                    if errorlevel 1 exit /b 1
                
                    call npm.cmd --version
                    if errorlevel 1 exit /b 1
                
                    git --version
                    if errorlevel 1 exit /b 1
                '''
            }
        }
        
        stage('Checkout') {
            steps {
                git branch: 'ilyas',
                    url: 'https://github.com/Z0J0-hub/Booking_Ruangan-Lab.git'
        
                bat '''
                    git branch --show-current
                    if errorlevel 1 exit /b 1
        
                    git log -1 --oneline
                    if errorlevel 1 exit /b 1
                '''
            }
        }
        
        stage('Install Dependencies') {
            steps {
                bat '''
                    call npm.cmd ci --no-audit --no-fund
                    if errorlevel 1 exit /b 1
                '''
        
                dir('backend') {
                    bat '''
                        call npm.cmd ci --no-audit --no-fund
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }
        
        stage('Dependency Audit') {
            steps {
                bat '''
                    @echo off
                    call npm.cmd run ci:audit
                    if errorlevel 1 exit /b 1
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/audit/*',
                        fingerprint: true
                }
            }
        }
        
        stage('Quality Checks') {
            steps {
                bat '''
                    call npm.cmd run lint
                    if errorlevel 1 exit /b 1
        
                    call npm.cmd run typecheck
                    if errorlevel 1 exit /b 1
                '''
            }
        }
        
        stage('Backend Tests') {
            steps {
                dir('backend') {
                    bat '''
                        call npm.cmd test
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }
        
        stage('Build') {
            steps {
                bat '''
                    call npm.cmd run build
                    if errorlevel 1 exit /b 1
                '''
            
                dir('backend') {
                    bat '''
                        call npm.cmd run build
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }
        
        stage('Archive Build') {
            steps {
                archiveArtifacts artifacts: 'dist/**',
                    fingerprint: true
            }
        }
    }
}
