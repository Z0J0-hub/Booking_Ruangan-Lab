// PR-only pipeline. No branch build, OWASP demonstration, deployment or DAST.
properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10')),
    pipelineTriggers([cron('H/5 * * * *')]),
    parameters([
        string(name: 'NOMOR_PR', defaultValue: '', trim: true, description: 'PR terbuka menuju development dari repo tim. Kosong = cari otomatis. Kode yang diperiksa adalah gabungan PR dan development.'),
        booleanParam(name: 'PERIKSA_ULANG_PR', defaultValue: true, description: 'Periksa lagi PR saat build manual, meskipun kodenya belum berubah. Jadwal otomatis hanya memeriksa perubahan baru.'),
        string(name: 'SUPABASE_URL', defaultValue: params.SUPABASE_URL ?: env.CI_SUPABASE_URL ?: '', trim: true, description: 'Pengaturan publik untuk build. Biarkan nilai yang sudah tersimpan.'),
        string(name: 'SUPABASE_PUBLIC_KEY', defaultValue: params.SUPABASE_PUBLIC_KEY ?: env.CI_SUPABASE_PUBLIC_KEY ?: '', trim: true, description: 'Kunci publik untuk build; jangan isi password atau kunci rahasia.')
    ])
])
node {
    timestamps {
        timeout(time: 30, unit: 'MINUTES') {
            def selected = false
            try {
                stage('Siapkan pipeline') {
                    if (isUnix()) { error('Job ini memerlukan agent Windows.') }
                    def checked = checkout scm
                    env.GIT_COMMIT = checked.GIT_COMMIT
                    if (!(env.GIT_COMMIT ?: '').matches('[a-f0-9]{40}')) { error('Versi pipeline tidak valid.') }
                    bat 'node scripts/pr/cleanup.mjs'
                    dir('reports') { deleteDir() }
                    def timer = !currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause').isEmpty()
                    env.PR_NUMBER = timer ? '' : (params.NOMOR_PR ?: '')
                    env.PR_FORCE_RESCAN = !timer && params.PERIKSA_ULANG_PR ? 'true' : 'false'
                    env.CI_RUN_MODE = 'pr'
                    env.VITE_SUPABASE_URL = params.SUPABASE_URL ?: env.CI_SUPABASE_URL ?: ''
                    env.VITE_SUPABASE_ANON_KEY = params.SUPABASE_PUBLIC_KEY ?: env.CI_SUPABASE_PUBLIC_KEY ?: ''
                }
                stage('Cari PR menuju development') {
                    def code = bat(returnStatus: true, script: '@echo off\nnode scripts/pr/plan.mjs')
                    currentBuild.description = bat(returnStdout: true, script: '@echo off\nnode scripts/pr/plan.mjs --describe').trim()
                    if (code == 3) {
                        currentBuild.result = 'NOT_BUILT'
                        echo 'Tidak ada PR baru yang perlu diperiksa; proses selesai di sini.'
                        return
                    }
                    if (code != 0) { error('PR tidak dapat dipilih; lihat reports/pr/plan.json.') }
                    selected = true
                }
                stage('Siapkan alat pemeriksa') {
                    bat '''@echo off
call npm.cmd ci --no-audit --no-fund
if errorlevel 1 exit /b 1
call npm.cmd run ci:sast:setup
if errorlevel 1 exit /b 1
call npm.cmd run ci:infra:setup
if errorlevel 1 exit /b 1
'''
                }
                stage('Ambil kode PR') { bat 'node scripts/pr/check.mjs prepare' }
                stage('Infrastructure Configuration') { bat 'node scripts/pr/check.mjs infra' }
                stage('Dependency Audit') { bat 'node scripts/pr/check.mjs audit' }
                stage('SAST OWASP Top 10') { bat 'node scripts/pr/check.mjs sast' }
                stage('Build development') { bat 'node scripts/pr/check.mjs build' }
                stage('STRIDE Database') {
                    withCredentials([string(credentialsId: 'supabase-stride-database-url', variable: 'STRIDE_DATABASE_URL')]) {
                        withEnv(['CHANGE_TARGET=development', 'PROOF_GATE=none', 'RUN_STRIDE_DATABASE=true', 'STRIDE_RUNNER_TRUSTED=true', 'STRIDE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com', 'STRIDE_ALLOW_TEST_WRITES=rollback-only', 'STRIDE_CA_FILE=security/certificates/prod-ca-2021.crt']) {
                            bat '''@echo off
node scripts/ci/policy.mjs
if errorlevel 1 exit /b 1
node scripts/pr/check.mjs stride
'''
                        }
                    }
                }
                stage('Simpan hasil PR') { bat 'node scripts/pr/check.mjs complete' }
            } finally {
                if (selected && fileExists('reports/pr/summary.json')) { bat 'node scripts/pr/finalize.mjs' }
                archiveArtifacts artifacts: 'reports/pr/*.json,reports/infra/*,reports/audit/*,reports/sast/*,reports/build/**,reports/stride/*', allowEmptyArchive: true, fingerprint: true
                if (fileExists('scripts/pr/cleanup.mjs')) { bat 'node scripts/pr/cleanup.mjs' }
            }
        }
    }
}
