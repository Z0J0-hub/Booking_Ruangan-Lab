pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10'))
    }

    parameters {
        string(name: 'SUPABASE_URL', defaultValue: '', trim: true,
            description: 'Public Supabase project URL for this build.')
        string(name: 'SUPABASE_PUBLIC_KEY', defaultValue: '', trim: true,
            description: 'Public anon/publishable key. Never enter a service_role/secret key.')
        booleanParam(name: 'RUN_STRIDE_DATABASE', defaultValue: false,
            description: 'Opt-in: write synthetic fixtures to an approved development DB, then ROLLBACK. Read the STRIDE guide first.')
        string(name: 'STRIDE_DB_HOST', defaultValue: '', trim: true,
            description: 'Approved test database hostname only; never enter a password here.')
    }

    environment {
        VITE_SUPABASE_URL = "${params.SUPABASE_URL ?: env.CI_SUPABASE_URL ?: ''}"
        VITE_SUPABASE_ANON_KEY = "${params.SUPABASE_PUBLIC_KEY ?: env.CI_SUPABASE_PUBLIC_KEY ?: ''}"
    }

    stages {

        stage('Cek Lingkungan') {
            steps {
                script {
                    if (isUnix()) { error('Jenkinsfile.dev requires a Windows agent.') }
                }
                bat '''
                    whoami
                    hostname

                    node --version
                    if errorlevel 1 exit /b 1

                    call npm.cmd --version
                    if errorlevel 1 exit /b 1

                    git --version
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Checkout') {
            steps {
                checkout scm

                bat '''
                    git rev-parse --verify HEAD
                    if errorlevel 1 exit /b 1

                    git log -1 --oneline
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Pipeline Policy') {
            steps {
                // Remove generated reports from older runs on reused agents.
                dir('reports') { deleteDir() }
                withEnv(["RUN_STRIDE_DATABASE=${params.RUN_STRIDE_DATABASE}"]) {
                    bat 'node scripts/ci/policy.mjs'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '''
                    call npm.cmd ci --no-audit --no-fund
                    if errorlevel 1 exit /b 1
                '''

            }
        }

        stage('CI Module Tests') {
            steps {
                bat '''
                    @echo off
                    call npm.cmd run test:ci
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Secret Scan') {
            steps {
                bat '''
                    @echo off
                    call npm.cmd run ci:secrets
                    if errorlevel 1 exit /b 1
                    call npm.cmd run test:secret-gate
                    if errorlevel 1 exit /b 1
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/secrets/*',
                        fingerprint: true
                }
            }
        }

        stage('Dependency Audit') {
            steps {
                bat '''
                    @echo off
                    call npm.cmd run ci:audit
                    if errorlevel 1 exit /b 1
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/audit/*',
                        fingerprint: true
                }
            }
        }

        stage('SAST') {
            steps {
                bat 'call npm.cmd run ci:sast'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/sast/*', fingerprint: true
                }
            }
        }

        stage('Quality Checks') {
            steps {
                bat '''
                    call npm.cmd run lint
                    if errorlevel 1 exit /b 1

                    call npm.cmd run typecheck
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Supabase Configuration') {
            steps {
                bat '''
                    @echo off
                    call npm.cmd run supabase:check -- --mode=production
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Auth Module Tests') {
            steps {
                bat '''
                    @echo off
                    call npm.cmd run test:auth
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('STRIDE Database') {
            when {
                allOf {
                    expression { params.RUN_STRIDE_DATABASE }
                    branch 'development'
                    not { changeRequest() }
                }
            }
            options { timeout(time: 5, unit: 'MINUTES') }
            steps {
                // Only generated reports are cleared; credential errors must not publish stale results.
                dir('reports/stride') { deleteDir() }
                withCredentials([string(credentialsId: 'supabase-stride-database-url', variable: 'STRIDE_DATABASE_URL')]) {
                    withEnv(["STRIDE_DB_HOST=${params.STRIDE_DB_HOST}", 'STRIDE_ALLOW_TEST_WRITES=rollback-only']) {
                        bat '''
                            @echo off
                            call npm.cmd run ci:stride
                            if errorlevel 1 exit /b 1
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/stride/*', fingerprint: true
                }
            }
        }

        stage('Build') {
            steps {
                bat '''
                    call npm.cmd run build
                    if errorlevel 1 exit /b 1
                '''

            }
        }

        stage('Archive Build') {
            steps {
                archiveArtifacts artifacts: 'dist/**',
                    fingerprint: true
            }
        }
    }
}
