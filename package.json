{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "ci:audit": "node scripts/ci/audit.mjs",
    "ci:sast": "node scripts/ci/sast.mjs",
    "test:ci": "node --test scripts/ci/*.test.mjs scripts/supabase/check.test.mjs scripts/stride/run.test.mjs",
    "test:secret-gate": "node --test scripts/ci/secret-gate.integration.mjs",
    "ci:secrets": "node scripts/ci/secrets.mjs",
    "ci:secrets:setup": "node scripts/ci/gitleaks-tool.mjs",
    "ci:stride": "node scripts/stride/run.mjs",
    "test:stride-runner": "node --test scripts/stride/run.test.mjs",
    "supabase:check": "node scripts/supabase/check.mjs",
    "test:auth": "node --experimental-strip-types --test src/features/auth/auth.test.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "eslint-plugin-security": "3.0.1",
    "globals": "^15.9.0",
    "pg": "8.23.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "7.3.8"
  }
}
